<mujoco model="right_shadow_hand scene">

  <!-- <option gravity="0 0 0"/>  -->
  <option timestep="0.002" iterations="100" noslip_iterations="5"/>
  <compiler texturedir="assets"/>
  <include file="right_hand_tilted.xml"/>

  <statistic extent="0.3" center="0.3 0 0"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="0"/>
    <global azimuth="220" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <keyframe>
    <!-- How was the pose found?
        1. set good-looking "writing" hand pose manually, ignore the pen
        2. "Copy pose" from the GUI and paste the hand pose values to qpos
        3. set good initial pose for the pen, [0.05 -0.33 0.02 0.9238795 -0.2705981 -0.2705981 0]
           (quaternion was calculated by computing -45 degree rotation around (0, 1, 0) axis)
        4. adjust as needed
        5. finally, "Copy Pose" again and paste
        -->
    <key name="grasp"
         qpos="-0.053531 0.0425488 0.184561 0.231019 0.356285 1.39916 -0.00599355 0.773754 0.963947 0.962314 -0.00471573 1.00176 1.56436 1.57098 0.00814543 -0.00493721 1.00089 1.56463 1.57107 0.850487 0.766683 0.00539355 -0.0299314 0.57146 0.0514295 -0.367737 -0.0129481 0.923815 -0.282243 -0.0562017 0.252479"
         ctrl="0 0 1.00512 0.75153 0.002094 0 0.590452 0.17455 0.269712 1.80665 -0.024437 0.737076 1.91662 0 1 3.14 0 0 1 3.14"/>
  </keyframe>

  <worldbody>

    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>

    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <body name="pen" pos="0 0 0" >
      <freejoint/>
      <geom type="capsule" size="0.007 0.065" priority="1" friction="1.5 0.01 0.003" contype="5" conaffinity="5"/> 
      <geom type="capsule" size="0.004 0.0075" pos="0 0 -0.0725"/>
      <body name="pen_tip" pos="0 0 -0.084"> 
        <geom type="sphere" size="0.001" mass="0.00" rgba="1 0 0 1" friction="0.1 0.0 0.0" contype="5" conaffinity="5"/>
      </body>
    </body>

    <body name="paper" pos="0.1 -0.35 -0.09">
      <geom type="box" size="0.1 0.1 0.0001" mass="0" rgba="1 1 0 0.8" friction="0.1 0 0" contype="5" conaffinity="5" solref="0.005 1" solimp="0.99 0.99 0.001 0.5 2" />
    </body>  

  </worldbody>
</mujoco>



