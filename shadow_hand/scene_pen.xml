<mujoco model="right_shadow_hand scene">

  <option timestep="0.002" iterations="100" noslip_iterations="5" tolerance="0" noslip_tolerance="0"/>
  <compiler texturedir="assets"/>
  <include file="right_hand_tilted.xml"/>

  <statistic extent="0.3" center="0.3 0 0"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="0"/>
    <global azimuth="220" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="512" height="3072"/>
  </asset>

  <keyframe>
    <!-- How was the pose found?
        1. set good-looking "writing" hand pose manually, ignore the pen
        2. "Copy pose" from the GUI and paste the hand pose values to qpos
        3. set good initial pose for the pen, [0.05 -0.33 0.02 0.9238795 -0.2705981 -0.2705981 0]
           (quaternion was calculated by computing -45 degree rotation around (0, 1, 0) axis)
           pen can be moved kinematically by pausing, double clicking the pen, and dragging it while pressing ctrl
        4. adjust as needed
        5. finally, "Copy Pose" again and paste
        -->
    <key name="grasp"
        qpos="-0.0822847 -0.0337926 0.199156 0.385924 0.18598 1.27406 -0.00607655 0.79235 0.969614 0.95388 -0.00465723 1.00168 1.56439 1.57099 0.0137047 -0.00487282 1.00079 1.56467 1.57108 0.879875 0.785381 0.0137313 -0.026186 0.56996 0.0409343 -0.375542 -0.00922318 0.783129 -0.231196 -0.00266616 0.577279"
        ctrl="-0.0277667 -0.0774413 1.02545 0.755125 0.00448995 0.00480585 0.597024 0.178041 0.416336 1.47674 -0.0243725 0.77968 1.91609 0 1 3.14 0 0 1 3.14"
      />
  </keyframe>

  <worldbody>

    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>

    <body name="pen" pos="0 0 0" >
      <freejoint/>
      <!-- Main pen body that the robnot will grip -->
      <geom type="capsule" size="0.007 0.065" priority="1" friction="1.5 0.01 0.003" contype="5" conaffinity="5"/> 
      <!-- smaller pen body just for aesthetics -->
      <geom type="capsule" size="0.004 0.0075" pos="0 0 -0.0725"/>
      <body name="pen_tip" pos="0 0 -0.084"> 
        <geom type="sphere" size="0.001" mass="0.00" rgba="1 0 0 1" friction="0.1 0.0 0.0" contype="5" conaffinity="5"/>
      </body>
    </body>

  </worldbody>
</mujoco>



